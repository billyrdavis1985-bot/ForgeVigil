{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgevigil:registry:v1",
  "title": "ForgeVigil registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "registry_id",
    "actors",
    "documents",
    "recipients",
    "approvals"
  ],
  "properties": {
    "format": {
      "const": "forgevigil.registry.v1"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "minLength": 1,
      "maxLength": 64
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actor"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "recipients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipient"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval"
      },
      "minItems": 0,
      "maxItems": 1024
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "active",
        "may_send_documents"
      ],
      "properties": {
        "id": {
          "const": "operator"
        },
        "active": {
          "type": "boolean"
        },
        "may_send_documents": {
          "type": "boolean"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "status",
        "classification",
        "sha256",
        "content_base64"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "status": {
          "enum": [
            "active",
            "withdrawn"
          ]
        },
        "classification": {
          "enum": [
            "approved_public",
            "restricted"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_base64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 1398104,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "name",
        "address",
        "approved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "pattern": "^[\\x21-\\x3F\\x41-\\x7E]+@[A-Za-z0-9.-]+$",
          "not": {
            "pattern": "[^\\x21-\\x7E]"
          }
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "actor_id",
        "document_id",
        "document_version",
        "document_sha256",
        "recipient_id",
        "recipient_version",
        "recipient_address_sha256",
        "status"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "actor_id": {
          "const": "operator"
        },
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "document_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "document_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recipient_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "recipient_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "minLength": 1,
          "maxLength": 64
        },
        "recipient_address_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        }
      }
    }
  }
}
